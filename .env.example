# Copy to .env and fill in your credentials (never commit .env)
PORT=8085
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=70
TELEGRAM_WATCHLIST_MIN_SCORE=40

NSE_POLLER_ENABLED=true
NSE_POLL_DELAY_MS=3000
NSE_MARKET_HOURS_ONLY=false
RETENTION_DAYS=365

# DhanHQ v2 Live Market Feed & Historical/Intraday Data
DHAN_ENABLED=false
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_WS_URL=wss://api-feed.dhan.co
DHAN_REQUEST_CODE=17
DHAN_AUTH_TYPE=2
DHAN_VERSION=2
DHAN_PIN=
DHAN_TOTP_SECRET=

# 3-Stage Intraday Funnel & Risk Sizing
FUNNEL_ENABLED=true
TRADER_CAPITAL_INR=100000
TRADER_RISK_PCT=1.0


